# Скопіюйте цей файл у .env.local і впишіть реальні значення.
#   cp .env.local.example .env.local   (або скопіюйте вручну)
#
# Де взяти значення: Supabase Dashboard -> ваш проєкт ->
#   Project Settings -> API
#     Project URL              -> VITE_SUPABASE_URL
#     Project API keys -> anon public -> VITE_SUPABASE_ANON_KEY
#
# anon-ключ безпечно тримати у фронтенді (він публічний за задумом).
# Файл .env.local у git НЕ потрапляє (див. .gitignore).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
